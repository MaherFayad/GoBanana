---
// Page title plus the page description as a lead, so every page opens with what it is for.
const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top">{title}</h1>
{description && <p class="gb-lead">{description}</p>}

<style>
	h1 {
		margin-top: 1.25rem;
		font-size: var(--sl-text-h1);
		line-height: 1;
		font-weight: 600;
		letter-spacing: var(--gb-tracking);
		color: var(--gb-heading);
		text-wrap: balance;
	}
	:global(:root[lang='ar']) h1 {
		line-height: 1.3;
	}
	.gb-lead {
		max-inline-size: 42rem;
		margin: 0.85rem 0 0;
		color: var(--gb-heading-dim);
		font-size: 1.08rem;
		line-height: 1.5;
	}
</style>
