---
// Replaces the social icons with one link back to the main site, in the page language.
const ar = Astro.locals.starlightRoute.lang === 'ar';
const href = ar ? '/ar' : '/en';
const label = ar ? 'الموقع الرئيسي' : 'Main site';
---

<a class="gb-site-link" href={href}>
	<span>{label}</span>
	<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg>
</a>

<style>
	.gb-site-link {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--sl-color-gray-1);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}
	.gb-site-link:hover {
		color: var(--sl-color-white);
	}
	:global([dir='rtl']) .gb-site-link svg {
		transform: scaleX(-1);
	}
</style>
