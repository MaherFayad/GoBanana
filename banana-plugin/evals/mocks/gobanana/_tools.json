{
  "tools": [
    {
      "name": "bend_brief",
      "title": "Bend a brief",
      "description": "Turn a design brief into unexpected directions (bend moves). Rule-based, free and unlimited. Use first when the user wants wild or fresh design ideas.",
      "inputSchema": {
        "type": "object",
        "required": [
          "brief",
          "wildness"
        ],
        "properties": {
          "brief": {
            "type": "string",
            "maxLength": 500
          },
          "wildness": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 Fresh, 2 Bold, 3 Weird, 4 Wild, 5 Bananas"
          },
          "moves": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "transplant",
                "material",
                "era",
                "constraint",
                "scale",
                "lens"
              ]
            }
          },
          "lens": {
            "type": "string",
            "description": "Culture lens preset id, for example sadu, najdi, kufic, mashrabiya, desert-modern"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "default": 6
          },
          "taste": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "minItems": 1,
            "maxItems": 5
          },
          "canvasId": {
            "type": "string",
            "description": "Canvas from open_canvas. Saves the directions there so search_references can take a directionId."
          }
        }
      }
    },
    {
      "name": "search_references",
      "title": "Search references",
      "description": "Find UI references (app screens, web pages, dashboards, components) on Dribbble, Pinterest and Behance. Every result links to its source: always show the source link next to the image. Results are always UI, whatever the words: a wild idea belongs in the direction notes, not in the images. Pass a directionId from bend_brief (best: real screens and components for the brief, in the user's taste), or a query. Pass canvasId to add the results to that canvas tray. Pass taste with a few style words that describe the user's references, such as minimal, glassmorphism, dark mode, big typography, editorial; it is saved on the canvas. To redo one lane of a direction with better words, pass directionId, lane and query. Rate results with rate_references so later searches improve. mix is ignored (always UI). Results are links to the source pages only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "directionId": {
            "type": "string"
          },
          "query": {
            "type": "string",
            "maxLength": 300
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pinterest",
                "dribbble",
                "behance",
                "awwwards"
              ]
            }
          },
          "count": {
            "type": "integer",
            "minimum": 4,
            "maximum": 24,
            "default": 12
          },
          "canvasId": {
            "type": "string"
          },
          "taste": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "minItems": 1,
            "maxItems": 5
          },
          "lane": {
            "type": "string",
            "enum": [
              "fidelity",
              "taste",
              "component",
              "hero",
              "bridge",
              "locale"
            ],
            "description": "With directionId and query: search only this lane of the direction, with the query as its words (\"app ui\" is added when they name no UI)."
          },
          "mix": {
            "type": "string",
            "enum": [
              "ui",
              "balanced",
              "wild"
            ],
            "description": "Ignored: results are always UI. Kept so older calls still work."
          }
        }
      }
    },
    {
      "name": "rate_references",
      "title": "Rate references",
      "description": "Rate search results so later searches get better. Free. Pass referenceIds from search_references with verdict \"bad\" (off topic, shop or stock, cluttered, duplicate) or \"great\" (standouts only). Bad results leave the canvas tray and never come back in this user's searches. Each bad rating returns a hint for re-searching its lane.",
      "inputSchema": {
        "type": "object",
        "required": [
          "ratings"
        ],
        "properties": {
          "canvasId": {
            "type": "string",
            "description": "Canvas whose tray holds the results. Bad ones are removed from it."
          },
          "ratings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "referenceId",
                "verdict"
              ],
              "properties": {
                "referenceId": {
                  "type": "string"
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "great",
                    "bad"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "off_topic",
                      "low_craft",
                      "stock_or_shop",
                      "cluttered",
                      "duplicate",
                      "wrong_style",
                      "not_ui",
                      "great_craft",
                      "on_style",
                      "on_brief"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "rate_directions",
      "title": "Rate directions",
      "description": "Keep or drop bend_brief directions on a canvas after you judge them, so the board shows only usable ideas. Free. Pass the canvasId and one rating per directionId: \"drop\" (with reasons) for an idea with no UI path for this screen, too few usable references, off brief or a near duplicate; \"keep\" for the ones you show. A dropped direction leaves the canvas with its section, the items in it and its tray results. Later bends suggest often dropped ideas less.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "ratings"
        ],
        "properties": {
          "canvasId": {
            "type": "string",
            "description": "Canvas the directions were saved to (bend_brief with canvasId)."
          },
          "ratings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "directionId",
                "verdict"
              ],
              "properties": {
                "directionId": {
                  "type": "string"
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "keep",
                    "drop"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "no_ui_path",
                      "no_usable_refs",
                      "off_brief",
                      "duplicate_idea",
                      "too_literal",
                      "strong_salvage",
                      "great_refs"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "extract_palette",
      "title": "Extract palette",
      "description": "Pull a color palette from references on a canvas, with roles and WCAG contrast checks. Pairs are tagged ship or explore.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "itemIds"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "itemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "size": {
            "type": "integer",
            "minimum": 5,
            "maximum": 9,
            "default": 6
          },
          "addSwatches": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "new_canvas",
      "title": "New canvas",
      "description": "Create a moodboard canvas without showing it, and get its canvasId. Pass the canvasId to bend_brief, search_references and add_to_canvas, then call open_canvas with it to show the finished board.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "brief": {
            "type": "string",
            "maxLength": 500
          },
          "taste": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "minItems": 1,
            "maxItems": 5
          }
        }
      }
    },
    {
      "name": "open_canvas",
      "title": "Open moodboard canvas",
      "description": "Show a canvas inline (or create and show one without canvasId) and get its web link. To show a finished board, create it with new_canvas, fill it, then call this with its canvasId.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "brief": {
            "type": "string",
            "maxLength": 500
          },
          "taste": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "minItems": 1,
            "maxItems": 5
          }
        }
      }
    },
    {
      "name": "add_to_canvas",
      "title": "Add to canvas",
      "description": "Add references, notes, swatches or sections to a canvas.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "items"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "sectionId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "reference",
                    "note",
                    "swatch",
                    "section"
                  ]
                },
                "referenceId": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "hex": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "arrange_canvas",
      "title": "Arrange canvas",
      "description": "Lay out canvas items: by_direction, masonry, grid or hero.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "layout"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "layout": {
            "type": "string",
            "enum": [
              "by_direction",
              "masonry",
              "grid",
              "hero"
            ]
          },
          "sectionId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_canvas",
      "title": "Get canvas",
      "description": "Read a canvas: sections, items with source links and notes, palettes and the brief. Leave out canvasId to list the user's recent canvases, so you can add to one instead of creating another.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "canvasId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "export_kit",
      "title": "Export kit",
      "description": "Export a canvas as text files: design_md, agents_md, tokens, tailwind, figjam_spec, html_board, brief. Free plan: design_md and brief. You write the files.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "formats"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "design_md",
                "agents_md",
                "tokens",
                "tailwind",
                "figjam_spec",
                "html_board",
                "brief"
              ]
            }
          }
        }
      }
    }
  ]
}
