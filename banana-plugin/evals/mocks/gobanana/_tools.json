{
  "tools": [
    {
      "name": "bend_brief",
      "title": "Bend a brief",
      "description": "Turn a brief into unexpected directions for one page or two, each with a visual spec (type, color, layout, motion and more) and art direction queries. Rule-based, free and unlimited. Pass platform and pages; without pages it also returns wildSpots, places on that platform where weirdness pays off.",
      "inputSchema": {
        "type": "object",
        "required": [
          "brief",
          "wildness"
        ],
        "properties": {
          "brief": {
            "type": "string",
            "maxLength": 500
          },
          "wildness": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 Fresh, 2 Bold, 3 Weird, 4 Wild, 5 Bananas"
          },
          "moves": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "transplant",
                "material",
                "era",
                "constraint",
                "scale",
                "lens"
              ]
            }
          },
          "lens": {
            "type": "string",
            "description": "Culture lens preset id, for example sadu, najdi, kufic, mashrabiya, desert-modern"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "default": 6
          },
          "taste": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "minItems": 1,
            "maxItems": 5
          },
          "canvasId": {
            "type": "string",
            "description": "Canvas from open_canvas. Saves the directions there so search_references can take a directionId."
          },
          "platform": {
            "type": "string",
            "enum": [
              "mobile",
              "tablet",
              "website",
              "webapp",
              "any"
            ],
            "description": "mobile, tablet, website, webapp or any. Detected from the brief when left out."
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60
            },
            "maxItems": 3,
            "description": "Up to 3 pages or screens the wild idea is for, such as onboarding, pricing page, /launch."
          }
        }
      }
    },
    {
      "name": "search_references",
      "title": "Search references",
      "description": "Find references for a direction in two zones: ui (screens and components for the direction's platform, from UI galleries by platform plus Pinterest, Dribbble, Behance and Awwwards) and art (the wild idea as images: raw ingredient on Pinterest and Behance; shops and listings dropped). Every result has a zone and links to its source: always show the source link. Pass a directionId from bend_brief (zone defaults to both) or a query (zone ui). Pass canvasId to add results to that canvas tray. Without taste, the direction's own style words are used. At most 2 results per studio, newer first, UI kits dropped. To redo one lane, pass directionId, lane and query; lane art re-searches the art zone. Rate results with rate_references.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "directionId": {
            "type": "string"
          },
          "query": {
            "type": "string",
            "maxLength": 300
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pinterest",
                "dribbble",
                "behance",
                "awwwards"
              ]
            }
          },
          "count": {
            "type": "integer",
            "minimum": 4,
            "maximum": 24,
            "default": 12
          },
          "canvasId": {
            "type": "string"
          },
          "taste": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "minItems": 1,
            "maxItems": 5
          },
          "lane": {
            "type": "string",
            "enum": [
              "fidelity",
              "taste",
              "component",
              "hero",
              "bridge",
              "locale",
              "art"
            ],
            "description": "With directionId and query: search only this lane. UI lanes get \"app ui\" or the platform's words added when the query names no UI; lane art searches raw images with no UI words."
          },
          "mix": {
            "type": "string",
            "enum": [
              "ui",
              "balanced",
              "wild"
            ],
            "description": "Ignored. Use zone instead."
          },
          "zone": {
            "type": "string",
            "enum": [
              "ui",
              "art",
              "both"
            ],
            "description": "Which zone to search. Default both for a directionId, ui for a plain query."
          }
        }
      }
    },
    {
      "name": "rate_references",
      "title": "Rate references",
      "description": "Rate search results so later searches get better. Free. Pass referenceIds from search_references with verdict \"bad\" (off topic, shop or stock, cluttered, duplicate) or \"great\" (standouts only). Bad results leave the canvas tray and never come back in this user's searches. Each bad rating returns a hint for re-searching its lane.",
      "inputSchema": {
        "type": "object",
        "required": [
          "ratings"
        ],
        "properties": {
          "canvasId": {
            "type": "string",
            "description": "Canvas whose tray holds the results. Bad ones are removed from it."
          },
          "ratings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "referenceId",
                "verdict"
              ],
              "properties": {
                "referenceId": {
                  "type": "string"
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "great",
                    "bad"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "off_topic",
                      "low_craft",
                      "stock_or_shop",
                      "cluttered",
                      "duplicate",
                      "wrong_style",
                      "not_ui",
                      "great_craft",
                      "on_style",
                      "on_brief"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "rate_directions",
      "title": "Rate directions",
      "description": "Keep or drop bend_brief directions on a canvas after you judge them, so the board shows only usable ideas. Free. Pass the canvasId and one rating per directionId: \"drop\" (with reasons) for an idea with no UI path for this screen, too few usable references, off brief or a near duplicate; \"keep\" for the ones you show. A dropped direction leaves the canvas with its section, the items in it and its tray results. Keeps are recorded too. Later bends suggest often dropped ideas less and often kept ideas more.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "ratings"
        ],
        "properties": {
          "canvasId": {
            "type": "string",
            "description": "Canvas the directions were saved to (bend_brief with canvasId)."
          },
          "ratings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "directionId",
                "verdict"
              ],
              "properties": {
                "directionId": {
                  "type": "string"
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "keep",
                    "drop"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "no_ui_path",
                      "no_usable_refs",
                      "off_brief",
                      "duplicate_idea",
                      "too_literal",
                      "strong_salvage",
                      "great_refs"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "extract_palette",
      "title": "Extract palette",
      "description": "Pull a color palette from references on a canvas, with roles and WCAG contrast checks. Pairs are tagged ship or explore.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "itemIds"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "itemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "size": {
            "type": "integer",
            "minimum": 5,
            "maximum": 9,
            "default": 6
          },
          "addSwatches": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "new_canvas",
      "title": "New canvas",
      "description": "Create a moodboard canvas without showing it, and get its canvasId. Pass the canvasId to bend_brief, search_references and add_to_canvas, then call open_canvas with it to show the finished board.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "brief": {
            "type": "string",
            "maxLength": 500
          },
          "taste": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "minItems": 1,
            "maxItems": 5
          }
        }
      }
    },
    {
      "name": "open_canvas",
      "title": "Open moodboard canvas",
      "description": "Show a canvas inline (or create and show one without canvasId) and get its web link. To show a finished board, create it with new_canvas, fill it, then call this with its canvasId.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "brief": {
            "type": "string",
            "maxLength": 500
          },
          "taste": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "minItems": 1,
            "maxItems": 5
          }
        }
      }
    },
    {
      "name": "add_to_canvas",
      "title": "Add to canvas",
      "description": "Add references, notes, swatches or sections to a canvas. Reference items keep their zone: art items land in the section's Art direction row above the UI references grid. A reference can carry a note (what to steal, up to 280 characters). Links in notes are clickable.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "items"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "sectionId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "reference",
                    "note",
                    "swatch",
                    "section"
                  ]
                },
                "referenceId": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "hex": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "note": {
                  "type": "string",
                  "maxLength": 280,
                  "description": "For reference items: what to steal from it, for example steal: the stamped date as a section divider."
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "arrange_canvas",
      "title": "Arrange canvas",
      "description": "Lay out canvas items: by_direction, masonry, grid or hero.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "layout"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "layout": {
            "type": "string",
            "enum": [
              "by_direction",
              "masonry",
              "grid",
              "hero"
            ]
          },
          "sectionId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_canvas",
      "title": "Get canvas",
      "description": "Read a canvas: sections, items with source links and notes, palettes, the brief, the parts library grouped by role, and Frankenstein pages (stitches) with their row and slot skeletons. Leave out canvasId to list the user's recent canvases, so you can add to one instead of creating another.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "canvasId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "delete_canvas",
      "title": "Delete canvas",
      "description": "Delete a canvas for good: its sections, items, tray and share link. Frees a canvas slot on the free plan. Needs confirm: true. Only call it after the user has said yes to deleting this named canvas.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "confirm"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "confirm": {
            "type": "boolean",
            "const": true,
            "description": "Must be true. Ask the user first."
          }
        }
      }
    },
    {
      "name": "export_kit",
      "title": "Export kit",
      "description": "Export a kept direction as text files, each with a suggested path: design_md, direction_md, build_prompt, review, cursor_rules, copilot, agents_md, claude_md, tokens, tailwind, figjam_spec, html_board, brief, stitch_md (FRANKENSTEIN.md: a skeleton per Frankenstein page with roles, source links and notes), wireframe_html (frankenstein-wireframe.html: grey boxes with role labels, no reference images). Default scope page: files apply only to the named pages, inherit the project's design system and do not change it; paths go under design/explorations/<slug>/ (or .cursor/rules, .github/instructions). Free plan: design_md, brief, direction_md, build_prompt, stitch_md. You write the files.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "formats"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "design_md",
                "agents_md",
                "tokens",
                "tailwind",
                "figjam_spec",
                "html_board",
                "brief",
                "direction_md",
                "build_prompt",
                "review",
                "cursor_rules",
                "copilot",
                "claude_md",
                "stitch_md",
                "wireframe_html"
              ]
            }
          },
          "directionId": {
            "type": "string",
            "description": "One kept direction. Default: all kept directions."
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "maxItems": 10,
            "description": "Routes or globs the files apply to, such as app/pricing/** or /launch."
          },
          "scope": {
            "type": "string",
            "enum": [
              "page",
              "system"
            ],
            "default": "page",
            "description": "page (default): only the named pages, inherits the project's design system. system: the direction becomes the product's design system."
          }
        }
      }
    },
    {
      "name": "cut_parts",
      "title": "Cut parts",
      "description": "Frankenstein it, step 1: add parts to the canvas parts library. A part is a role plus a crop rectangle (fractions) over a board image item or a tray reference; the browser applies the crop, nothing is downloaded or stored. Pass the crop you judged by looking; without one the server guesses a band by role and image aspect and marks the part guessedCrop. Every part keeps its source link. Library limit 80 parts.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "cuts"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "cuts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "itemId": {
                  "type": "string",
                  "description": "Board image item to cut from."
                },
                "referenceId": {
                  "type": "string",
                  "description": "Tray or search reference to cut from."
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "nav",
                    "hero",
                    "logos",
                    "features",
                    "cards",
                    "gallery",
                    "stats",
                    "testimonial",
                    "pricing",
                    "cta",
                    "form",
                    "faq",
                    "content",
                    "footer",
                    "sidebar",
                    "toolbar",
                    "table",
                    "chart",
                    "filters",
                    "status-header",
                    "tabbar",
                    "list",
                    "detail",
                    "sheet",
                    "empty",
                    "other"
                  ]
                },
                "crop": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "description": "Rectangle as fractions (0 to 1) of the source image, x and y from the top left. The browser applies it; no image is cut or stored.",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "theme": {
                  "type": "string",
                  "enum": [
                    "light",
                    "dark",
                    "unknown"
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 280,
                  "description": "What to steal, starting with steal:"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "stitch_page",
      "title": "Stitch a Frankenstein page",
      "description": "Stack parts into new pages in a frame sized for the platform (390, 834 or 1440). Pass rows of part ids, or a recipe (roles top to bottom) plus variants (1 to 6) and the server fills each role from the parts library with seeded picks, mixing at least 3 sources per variant when it can. Frames go side by side on the canvas. Every slot shows its source.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "platform": {
            "type": "string",
            "enum": [
              "mobile",
              "tablet",
              "website",
              "webapp"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "collage",
              "wireframe",
              "even"
            ],
            "default": "collage"
          },
          "directionId": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "maxLength": 280,
            "description": "The idea in one line."
          },
          "rows": {
            "type": "array",
            "maxItems": 14,
            "items": {
              "type": "object",
              "required": [
                "slots"
              ],
              "properties": {
                "slots": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "required": [
                      "partId"
                    ],
                    "properties": {
                      "partId": {
                        "type": "string"
                      },
                      "crop": {
                        "type": "object",
                        "required": [
                          "x",
                          "y",
                          "w",
                          "h"
                        ],
                        "description": "Rectangle as fractions (0 to 1) of the source image, x and y from the top left. The browser applies it; no image is cut or stored.",
                        "properties": {
                          "x": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "y": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "w": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "h": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        }
                      },
                      "note": {
                        "type": "string",
                        "maxLength": 280
                      }
                    }
                  }
                },
                "widths": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          },
          "recipe": {
            "type": "array",
            "maxItems": 14,
            "items": {
              "type": "string",
              "enum": [
                "nav",
                "hero",
                "logos",
                "features",
                "cards",
                "gallery",
                "stats",
                "testimonial",
                "pricing",
                "cta",
                "form",
                "faq",
                "content",
                "footer",
                "sidebar",
                "toolbar",
                "table",
                "chart",
                "filters",
                "status-header",
                "tabbar",
                "list",
                "detail",
                "sheet",
                "empty",
                "other"
              ]
            }
          },
          "variants": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "default": 1
          }
        }
      }
    },
    {
      "name": "remix_stitch",
      "title": "Remix a Frankenstein page",
      "description": "Make new variants of a Frankenstein page next to it. lock keeps slots (slot ids or roles); vary names the roles to swap (default: every unlocked slot). Seeded: the same call gives the same result.",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "stitchId",
          "count"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "stitchId": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "lock": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Slot ids (sl-...) or roles to keep."
          },
          "vary": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "nav",
                "hero",
                "logos",
                "features",
                "cards",
                "gallery",
                "stats",
                "testimonial",
                "pricing",
                "cta",
                "form",
                "faq",
                "content",
                "footer",
                "sidebar",
                "toolbar",
                "table",
                "chart",
                "filters",
                "status-header",
                "tabbar",
                "list",
                "detail",
                "sheet",
                "empty",
                "other"
              ]
            }
          }
        }
      }
    },
    {
      "name": "update_stitch",
      "title": "Edit a Frankenstein page",
      "description": "Edit one Frankenstein page with ops: swap (slotId, partId), move (slotId, rowId, index), moveRow (rowId, index), remove (slotId or rowId), insert (index, slots, widths), crop (slotId, crop), widths (rowId, widths), mode (collage, wireframe, even), note (note, optional slotId), title (title).",
      "inputSchema": {
        "type": "object",
        "required": [
          "canvasId",
          "stitchId",
          "ops"
        ],
        "properties": {
          "canvasId": {
            "type": "string"
          },
          "stitchId": {
            "type": "string"
          },
          "ops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "op"
              ],
              "properties": {
                "op": {
                  "type": "string",
                  "enum": [
                    "swap",
                    "move",
                    "moveRow",
                    "remove",
                    "insert",
                    "crop",
                    "widths",
                    "mode",
                    "note",
                    "title"
                  ]
                },
                "slotId": {
                  "type": "string"
                },
                "rowId": {
                  "type": "string"
                },
                "partId": {
                  "type": "string"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "slots": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "required": [
                      "partId"
                    ],
                    "properties": {
                      "partId": {
                        "type": "string"
                      },
                      "crop": {
