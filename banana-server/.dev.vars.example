# Local secrets for `wrangler dev` / `npm run preview`. Copy to .dev.vars (git-ignored).
# In production set each with: npx wrangler secret put <NAME>
# Non-secret values live in wrangler.jsonc "vars"; values here override them locally.
NEXTJS_ENV=development

WORKOS_API_KEY=
# Web sign-in session cookie key, 32+ characters (openssl rand -base64 32).
WORKOS_COOKIE_PASSWORD=
DATABASE_URL=
SERPER_API_KEY=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Local overrides of wrangler.jsonc vars
APP_URL=http://localhost:8787
MCP_RESOURCE_URL=http://localhost:8787/api/mcp
WORKOS_AUTHKIT_DOMAIN=
WORKOS_CLIENT_ID=
# Must match a redirect URI in WorkOS. Optional: defaults to APP_URL + /auth/callback.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:8787/auth/callback

# Payments are off: every free user gets Pro limits. Remove at launch.
BETA_PLAN=pro

# Most Serper credits all users together may spend per UTC month. Empty: no cap.
SERPER_MONTHLY_CREDIT_CAP=2500
