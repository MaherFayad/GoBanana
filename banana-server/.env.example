# For `next dev` (copy to .env.local). Spec section 15. Never commit real values.
APP_NAME=Banana
APP_URL=http://localhost:3000
MCP_RESOURCE_URL=http://localhost:3000/api/mcp

# WorkOS AuthKit (Dashboard: API keys, and Authentication > AuthKit domain)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_AUTHKIT_DOMAIN=https://your-subdomain.authkit.app

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Workers R2 binding name (see wrangler.jsonc)
R2_BUCKET=R2_BUCKET

SERPER_API_KEY=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_FOUNDING=

# Comma-separated image hosts, see spec section 9
IMAGE_HOST_ALLOWLIST=
