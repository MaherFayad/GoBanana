# For `next dev` (copy to .env.local). Spec section 15. Never commit real values.
APP_NAME=Banana
APP_URL=http://localhost:3000
MCP_RESOURCE_URL=http://localhost:3000/api/mcp

# WorkOS AuthKit (Dashboard: API keys, and Authentication > AuthKit domain)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_AUTHKIT_DOMAIN=https://your-subdomain.authkit.app
# Web sign-in session cookie key, 32+ characters (openssl rand -base64 32). Secret.
WORKOS_COOKIE_PASSWORD=
# Must match a redirect URI in WorkOS. Optional: defaults to APP_URL + /auth/callback.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Workers R2 binding name (see wrangler.jsonc)
R2_BUCKET=R2_BUCKET

SERPER_API_KEY=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_FOUNDING=

# Comma-separated image hosts, see spec section 9
IMAGE_HOST_ALLOWLIST=

# Paddle client side and environment (billing agent)
PADDLE_CLIENT_TOKEN=
PADDLE_ENV=sandbox

# Shown in the privacy notice and takedown page
LEGAL_CONTACT_EMAIL=

# Payments are off: every free user gets Pro limits. Remove at launch.
BETA_PLAN=pro

# Test only: Playwright signs in as a fixed user. Ignored when NODE_ENV=production
# (next build, the Worker). Never set this anywhere else.
# E2E_AUTH_BYPASS=1
