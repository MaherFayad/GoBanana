{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gobanana-server",
  "account_id": "d4747e2944f64aa7bfd27f0abddb1993",
  // custom-worker.ts wraps the generated .open-next/worker.js and adds the cron handler.
  "main": "custom-worker.ts",
  // Must not be later than the bundled workerd release (1.20261006).
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Workers Free caps the upload at 3 MB gzipped. OpenNext leaves identifiers (and the
  // whole middleware bundle) unminified, so wrangler minifies the final bundle.
  "minify": true,
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Smart Placement: the Worker runs near the database (Neon, us-east-2) instead of near the
  // visitor. A signed-in page makes several database round trips in a row; from the Gulf each
  // one cost about 200 ms at the edge. Static assets are still served from the edge.
  "placement": { "mode": "smart" },
  // Daily at 03:17 UTC: purge references older than 30 days that are not on a canvas, and
  // search ratings older than 12 months.
  "triggers": { "crons": ["17 3 * * *"] },
  // User uploads and export files only (never third-party images).
  // Create first: npx wrangler r2 bucket create banana-uploads
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "banana-uploads"
    }
  ],
  // Non-secret config. Replace the placeholders with your workers.dev URL and
  // AuthKit domain before deploying. Secrets (WORKOS_API_KEY, DATABASE_URL, ...)
  // go in .dev.vars locally and `npx wrangler secret put <NAME>` in production.
  "vars": {
    "APP_NAME": "GoBanana",
    "APP_URL": "https://gobanana-server.maherfayad55.workers.dev",
    "MCP_RESOURCE_URL": "https://gobanana-server.maherfayad55.workers.dev/api/mcp",
    "WORKOS_CLIENT_ID": "client_01M4NBKJEZYVMTKFEG0Y7WXFBZ",
    "WORKOS_AUTHKIT_DOMAIN": "https://sensitive-conch-18-staging.authkit.app",
    "IMAGE_HOST_ALLOWLIST": "",
    // Payments are off: every free user gets Pro limits. Remove at launch.
    "BETA_PLAN": "pro",
    // Search learning from rate_references across users ("off": each user's own ratings only).
    "GLOBAL_LEARNING": "on",
    // Most Serper credits all users together may spend per UTC month (owner decision D2). Empty: no cap.
    "SERPER_MONTHLY_CREDIT_CAP": "2500"
  }
}
