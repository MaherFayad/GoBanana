{
  "name": "banana-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:preview": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "@neondatabase/serverless": "^1.2.0",
    "@xyflow/react": "^12.12.0",
    "culori": "^4.0.2",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "jpeg-js": "^0.4.4",
    "mcp-handler": "^2.3.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "upng-js": "^2.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@google/design.md": "0.4.0",
    "@opennextjs/cloudflare": "^1.20.10",
    "@playwright/test": "1.56.1",
    "@types/culori": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/upng-js": "^2.1.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
